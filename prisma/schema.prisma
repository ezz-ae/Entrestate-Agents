generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = process.env.DATABASE_URL
}

model Agent {
  id                String   @id @default(cuid())
  name              String
  role              String
  context           String
  primaryDomain     String
  secondaryDomain   String?
  actions           String[] // Stored as array of strings
  confidenceThreshold Float    @default(0.8)
  voice             String
  accent            String
  status            String   @default("idle") // idle, active, paused
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String
  campaigns         Campaign[]
}

model Project {
  id                String   @id @default(cuid())
  name              String
  developer         String
  city              String
  area              String
  priceFrom         Float?
  completionYear    Int?
  investmentScore   Int      @default(0)
  ppb               Float?
  lifecycle         String
  description       String?
  kernelIdentity    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Campaign {
  id            String   @id @default(cuid())
  name          String
  status        String   @default("active")
  budget        Float
  spent         Float    @default(0)
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  leads         Lead[]
  createdAt     DateTime @default(now())
}

model Lead {
  id            String   @id @default(cuid())
  name          String?
  email         String?
  phone         String?
  source        String? // Instagram, Facebook, Web
  status        String   @default("new") // new, qualified, contacted
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  createdAt     DateTime @default(now())
}

model SpendLog {
  id          String   @id @default(cuid())
  amount      Float
  category    String   // Ad Spend, API usage, Caller
  description String?
  timestamp   DateTime @default(now())
}
